  p12: "\$12  (sans desc)" { class: visite }
  p13: "\$13  THE GOBLINS GATE" { class: visite }
  p14: "\$14  THE GOBLINS GATE" { class: patch }
  p15: "\$15  (sans desc)" { class: patch }
  p34: "\$34  (sans desc)" { class: visite }
  p35: "\$35  (sans desc)" { class: visite }
  p36: "\$36  (sans desc)" { class: visite }
  p37: "\$37  (sans desc)" { class: visite }
  p38: "\$38  (sans desc)" { class: visite }
