}
z_foret: "Foret noire, Lac & Montagne solitaire" {
  direction: down
  p02: "\$02  (sans desc)" { class: visite }
  p03: "\$03  (sans desc)" { class: visite }
  p08: "\$08  (sans desc)" { class: patch }
  p17: "\$17  (sans desc)" { class: visite }
  p1A: "\$1A  A PLACE OF BLACK SPIDERS" { class: patch }
  p1B: "\$1B  A FOREST OF TANGLED SMOTHERING TREE" { class: patch }
  p1C: "\$1C  AN ELVISH CLEARING WITH LEVELLED GRO" { class: patch }
  p1D: "\$1D  (sans desc)" { class: patch }
  p1E: "\$1E  (sans desc)" { class: sombre }
  p1F: "\$1F  A DARK DUNGEON IN THE ELVENKINGS HAL" { class: sombre }
  p20: "\$20  THE CELLAR WHERE THE KING KEEPS HIS " { class: sombre }
  p21: "\$21  (sans desc)" { class: visite }
  p22: "\$22  (sans desc)" { class: visite }
  p23: "\$23  A WOODEN TOWN IN THE MIDDLE OF LONG " { class: visite }
  p24: "\$24  A STRONG RIVER :THE CURRENT IS NOW T" { class: visite }
  p25: "\$25  A BLEAK BARREN LAND THAT WAS ONCE GR" { class: visite }
  p26: "\$26  THE RUINS OF THE TOWN OF DALE" { class: visite }
