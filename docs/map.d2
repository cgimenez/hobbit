# The Hobbit (Oric-1/Atmos 1982) - carte des lieux par zones
# GENERE par scripts/draw_map.py - NE PAS EDITER A LA MAIN.
direction: down
classes: {
  visite: { style: { fill: "#e6f4ea"; stroke: "#2e7d32"; font-color: "#1b3a24" } }
  patch:  { style: { fill: "#dbe7fb"; stroke: "#1565c0"; font-color: "#0d2b52"; stroke-dash: 4 } }
  sombre: { style: { fill: "#eceff1"; stroke: "#546e7a"; font-color: "#263238" } }
  inconnu: { style: { fill: "#ffffff"; stroke: "#9e9e9e"; font-color: "#616161" } }
  vide:   { style: { fill: "#f5f5f5"; stroke: "#9e9e9e"; font-color: "#616161"; stroke-dash: 4 } }
}

z_ouest: "Ouest : tunnel & Trollshaws" {
  direction: down
  p01: "\$01  A COMFORTABLE TUNNEL LIKE HALL" { class: visite }
  p04: "\$04  A GLOOMY EMPTY LAND WITH DREARY HILL" { class: visite }
  p05: "\$05  (sans desc)" { class: visite }
  p06: "\$06  A HIDDEN PATH WITH TROLLS FOOT PRINT" { class: visite }
  p07: "\$07  THE TROLLS CAVE" { class: visite }
  p09: "\$09  (sans desc)" { class: visite }
}
z_brumeux: "Monts Brumeux" {
  direction: down
  p0A: "\$0A  A HARD DANGEROUS PATH IN THE MISTY M" { class: visite }
  p0B: "\$0B  A NARROW PLACE WITH A DREADFUL DROP " { class: visite }
  p0C: "\$0C  A NARROW DANGEROUS PATH" { class: visite }
  p0E: "\$0E  A LARGE DRY CAVE WHICH IS QUITE COMF" { class: visite }
  p0F: "\$0F  (sans desc)" { class: visite }
  p16: "\$16  (sans desc)" { class: visite }
  p18: "\$18  THE GATE TO MIRKWOOD" { class: visite }
  p19: "\$19  A BEWITCHED GLOOMY PLACE SURROUNDED " { class: visite }
  p32: "\$32  (sans desc)" { class: patch }
  p42: "\$42  THE WEST{GOTO>BANK OF A BLACK RIVER}" { class: patch }
  p43: "\$43  THE EAST{GOTO>BANK OF A BLACK RIVER}" { class: patch }
}
z_gobelins: "Cavernes gobelines (nord)" {
  direction: down
  p0D: "\$0D  (sans desc)" { class: visite }
  p10: "\$10  A BIG CAVERN WITH TORCHESALONG THE W" { class: visite }
