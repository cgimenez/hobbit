  p2A: "\$2A  A LITTLE STEEP BAY,STILL AND QUIET,W" { class: visite }
  p2B: "\$2B  A SMOOTH STRAIGHT PASSAGE" { class: visite }
  p2C: "\$2C  THE LONELY MOUNTAIN" { class: visite }
  p2D: "\$2D  (sans desc)" { class: visite }
  p2E: "\$2E  (sans desc)" { class: visite }
  p30: "\$30  (sans desc)" { class: visite }
  p31: "\$31  (sans desc)" { class: visite }
  p33: "\$33  (sans desc)" { class: visite }
}
