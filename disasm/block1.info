GLOBAL { CPU "6502"; PAGELENGTH 0; };
RANGE { START $0400; END $0402; TYPE CODE; NAME "b1_entry"; COMMENT "Trampoline d'autorun : saute au demarrage du chargeur (b1_start)"; };
RANGE { START $0405; END $0467; TYPE CODE; NAME "b1_vec_sync"; };
RANGE { START $047C; END $04CB; TYPE CODE; NAME "b1_start"; COMMENT "Demarrage : detecte la ROM, relocalise les vecteurs, charge les blocs puis lance le jeu"; };
LABEL { NAME "b1_load"; ADDR $0417; COMMENT "Lit un bloc complet sur cassette : synchro, en-tete 9 octets, donnees, checksum EOR"; };
RANGE { START $0403; END $0404; TYPE BYTETABLE; };
RANGE { START $0468; END $047B; TYPE BYTETABLE; };
RANGE { START $04CC; END $04F8; TYPE TEXTTABLE; };
RANGE { START $04F9; END $04FF; TYPE BYTETABLE; };
LABEL { NAME "b1_vec_read"; ADDR $0408; };
LABEL { NAME "b1_vec_leader"; ADDR $040B; };
LABEL { NAME "b1_vec_write"; ADDR $040E; };
LABEL { NAME "b1_vec_setup"; ADDR $0411; };
LABEL { NAME "b1_vec_reset"; ADDR $0414; };
LABEL { NAME "PUTBYTE_10"; ADDR $E5C6; };
LABEL { NAME "READBYTE_10"; ADDR $E630; };
LABEL { NAME "TAPESYNC_10"; ADDR $E696; };
LABEL { NAME "WRITELEADER_10"; ADDR $E6BA; };
LABEL { NAME "SETUPTAPE_10"; ADDR $E6CA; };
LABEL { NAME "CHAR2SCR_10"; ADDR $F73C; };
LABEL { NAME "RESETSTAT_10"; ADDR $F960; };
LABEL { NAME "PUTBYTE_11"; ADDR $E65E; };
LABEL { NAME "READBYTE_11"; ADDR $E6C9; };
LABEL { NAME "SYNCTAPE_11"; ADDR $E735; };
LABEL { NAME "WRITELEADER_11"; ADDR $E75A; };
LABEL { NAME "SETUPTAPE_11"; ADDR $E76A; };
LABEL { NAME "CHAR2SCR_11"; ADDR $F77C; };
LABEL { NAME "RESETSTAT_11"; ADDR $F9AA; };
LABEL { NAME "col"; ADDR $0004; COMMENT "Nombre de colonnes restantes sur la ligne (pour couper la ligne au bon moment)"; };
LABEL { NAME "outen"; ADDR $000B; COMMENT "Autorise ou non l'affichage du texte (1 = autorise)"; };
LABEL { NAME "phase"; ADDR $000C; COMMENT "0 = simulation (le jeu calcule sans rien afficher), 1 = action reelle"; };
LABEL { NAME "raw"; ADDR $000D; COMMENT "Affichage brut : 1 = texte force, sans mise en forme"; };
LABEL { NAME "cap"; ADDR $000E; COMMENT "1 = mettre une majuscule a la prochaine lettre (apres un point)"; };
LABEL { NAME "sppend"; ADDR $000F; COMMENT "Un espace a inserer avant le prochain mot"; };
LABEL { NAME "crcnt"; ADDR $0011; COMMENT "Nombre de lignes affichees depuis la derniere pause (remis a zero toutes les 16)"; };
LABEL { NAME "passok"; ADDR $0012; COMMENT "1 = la simulation a reussi, on passe a l'action reelle"; };
LABEL { NAME "wid"; ADDR $0013; COMMENT "Mot courant interprete (verbe ou direction)"; };
LABEL { NAME "arg1"; ADDR $0015; COMMENT "Premier objet de la commande ($FF = aucun)"; };
LABEL { NAME "arg2"; ADDR $0016; COMMENT "Second objet de la commande ($FF = aucun)"; };
LABEL { NAME "orec"; ADDR $0017; COMMENT "Pointeur vers la fiche du premier objet (octet haut en $18)"; };
LABEL { NAME "orec2"; ADDR $0019; COMMENT "Pointeur vers la fiche du second objet (octet haut en $1A)"; };
LABEL { NAME "crec"; ADDR $00C6; COMMENT "Pointeur vers la fiche courante (compteurs du personnage/objet en cours)"; };
LABEL { NAME "adr"; ADDR $005C; COMMENT "Adresse de travail : mot de message en cours (octet haut en $5D)"; };
LABEL { NAME "tidx"; ADDR $006F; COMMENT "Position du caractere en cours dans le message affiche"; };
LABEL { NAME "nest"; ADDR $0070; COMMENT "Niveau d'imbrication du message (0 = message simple)"; };
LABEL { NAME "wptr"; ADDR $0071; COMMENT "Pointeur vers le mot ou nom en cours (octet haut en $72)"; };
LABEL { NAME "msgstk"; ADDR $0076; COMMENT "Index de la pile des messages imbriques"; };
LABEL { NAME "svA"; ADDR $00AD; COMMENT "Sauvegarde de l'accumulateur A"; };
LABEL { NAME "svX"; ADDR $00AE; COMMENT "Sauvegarde du registre X"; };
LABEL { NAME "rstk"; ADDR $00AF; COMMENT "Index de la pile interne d'adresses"; };
LABEL { NAME "direct"; ADDR $0073; COMMENT "Sortie normale, sans controle particulier"; };
LABEL { NAME "variant"; ADDR $0074; COMMENT "Sortie en variante (selon le type de commande)"; };
LABEL { NAME "xaux"; ADDR $0077; COMMENT "Octet auxiliaire : options de mise en forme de la sortie"; };
LABEL { NAME "xmode"; ADDR $0078; COMMENT "Octet de mode de la sortie (direct, variante...)"; };
LABEL { NAME "cond1"; ADDR $00DC; COMMENT "Condition memorisee n°1"; };
LABEL { NAME "cond2"; ADDR $00E2; COMMENT "Condition memorisee n°2"; };
LABEL { NAME "svptr"; ADDR $00E8; COMMENT "Sauvegarde du pointeur de travail"; };
LABEL { NAME "exitp"; ADDR $00F8; COMMENT "Curseur dans la table des sorties du lieu"; };
LABEL { NAME "ptr3"; ADDR $007A; COMMENT "Troisieme pointeur de travail (octet haut en $7B)"; };
LABEL { NAME "ptr2"; ADDR $0088; COMMENT "Pointeur secondaire, pour balayer les tables (octet haut en $89)"; };
LABEL { NAME "ptr"; ADDR $008A; COMMENT "Pointeur de travail principal (octet haut en $8B)"; };
LABEL { NAME "key"; ADDR $008F; COMMENT "Cle de l'evenement a declencher"; };
LABEL { NAME "noise"; ADDR $0093; COMMENT "Source du hasard (pour les tirages aleatoires)"; };
LABEL { NAME "exploc"; ADDR $00BE; COMMENT "Lieu attendu par l'evenement en cours"; };
LABEL { NAME "obj"; ADDR $00C5; COMMENT "Objet ou personnage courant ($FF = un personnage)"; };
LABEL { NAME "ploc"; ADDR $00C8; COMMENT "Lieu du joueur (simple copie : la vraie valeur est player.eloc en $1B2A)"; };
LABEL { NAME "eloc"; ADDR $00C9; COMMENT "Lieu d'un personnage (visible quand il est identique a celui du joueur)"; };
LABEL { NAME "once"; ADDR $00CE; COMMENT "Verrou 'une seule fois' : pose puis consomme"; };
LABEL { NAME "dflag"; ADDR $00C3; COMMENT "Flag de l'action du dragon : initialise a 0 par l'intro, jamais arme (inactif)"; };
LABEL { NAME "sflag"; ADDR $00C4; COMMENT "Flag de sortie texte : arme au desarmement de l'evenement e7, ajoute un H apres s/S"; };
LABEL { NAME "cand"; ADDR $00CF; COMMENT "Index de candidat dans les tables de deplacement $48D3/$48D5 (moteur d'errance)"; };
LABEL { NAME "mwt"; ADDR $00D0; COMMENT "Budget/poids du deplacement (moteur d'errance : $0A moins les couts)"; };
LABEL { NAME "qrd"; ADDR $00D1; COMMENT "Curseur de lecture de la file d'actions $4905 (remis a 0 a chaque commande)"; };
LABEL { NAME "qwr"; ADDR $00D2; COMMENT "Curseur d'ecriture de la file d'actions $4905 (remis a 0 a chaque commande)"; };
LABEL { NAME "macc"; ADDR $00D3; COMMENT "Accumulateur de poids du moteur d'errance"; };
LABEL { NAME "mcnt"; ADDR $00D4; COMMENT "Compteur de candidats retenus par le moteur d'errance"; };
LABEL { NAME "said"; ADDR $00D5; COMMENT "Flag : le PNJ a parle/refuse (pose par code_6C2E, remis a 0 par act_v14_13)"; };
LABEL { NAME "orec_hi"; ADDR $0018; COMMENT "Octet haut de orec"; };
LABEL { NAME "orec2_hi"; ADDR $001A; COMMENT "Octet haut de orec2"; };
LABEL { NAME "adr_hi"; ADDR $005D; COMMENT "Octet haut de adr"; };
LABEL { NAME "wptr_hi"; ADDR $0072; COMMENT "Octet haut de wptr"; };
LABEL { NAME "ptr3_hi"; ADDR $007B; COMMENT "Octet haut de ptr3"; };
LABEL { NAME "ptr2_hi"; ADDR $0089; COMMENT "Octet haut de ptr2"; };
LABEL { NAME "ptr_hi"; ADDR $008B; COMMENT "Octet haut de ptr"; };
LABEL { NAME "noise_hi"; ADDR $0094; COMMENT "Octet haut de noise"; };
LABEL { NAME "crec_hi"; ADDR $00C7; COMMENT "Octet haut de crec"; };
LABEL { NAME "svptr_hi"; ADDR $00E9; COMMENT "Octet haut de svptr"; };
LABEL { NAME "exitp_hi"; ADDR $00F9; COMMENT "Octet haut de exitp"; };
