LABEL { NAME "start"; ADDR $2C35; COMMENT "Point de depart du jeu : prepare la memoire, affiche le prompt, puis boucle de commandes"; };
LABEL { NAME "init_vars"; ADDR $2DC8; COMMENT "Remet a zero les compteurs de depart (variables de travail, pile de messages, score)"; };
LABEL { NAME "input_abort"; ADDR $2DDB; COMMENT "'@' en tete de ligne : recule le curseur de 2 et annule la saisie en cours"; };
LABEL { NAME "read_line"; ADDR $2DEA; COMMENT "Saisie d'une commande : affiche '> ', lit les touches et remplit le tampon $40BE"; };
LABEL { NAME "line_loop"; ADDR $2E04; COMMENT "Lit une touche, la traduit (fleches) puis la traite"; };
LABEL { NAME "line_read"; ADDR $2E0F; COMMENT "Lit une touche sans traduction (relecture apres effacement)"; };
LABEL { NAME "line_dispatch"; ADDR $2E12; COMMENT "Repartit la touche : fin de ligne, effacement ou edition"; };
LABEL { NAME "line_del"; ADDR $2E1A; COMMENT "Touche DEL ($7F) : efface toute la ligne saisie"; };
LABEL { NAME "line_backspace"; ADDR $2E24; COMMENT "Retour arriere ($08) : efface le dernier caractere et suit l'etat guillemet"; };
LABEL { NAME "line_edit"; ADDR $2E40; COMMENT "Edition d'un caractere : guillemets, espaces et ponctuation"; };
LABEL { NAME "line_classify"; ADDR $2E58; COMMENT "Trie le caractere saisi (espace, CR, point, virgule) avant stockage"; };
LABEL { NAME "line_store"; ADDR $2E68; COMMENT "Stocke le caractere dans le tampon de commande $40BE et l'affiche (echo)"; };
LABEL { NAME "line_cr"; ADDR $2E76; COMMENT "Entree : ferme la ligne (guillemet/point manquants), stocke CR et renvoie 1"; };
LABEL { NAME "ins_quote"; ADDR $2E8C; COMMENT "Ajoute un guillemet fermant si la saisie en a ouvert un"; };
LABEL { NAME "ins_period"; ADDR $2E98; COMMENT "Ajoute un point final a la commande si elle n'en a pas deja"; };
LABEL { NAME "key_arrow"; ADDR $2EA9; COMMENT "Fleches du clavier : les remplace par N/S/E/W (deplacement immediat, Oric)"; };
LABEL { NAME "key_n"; ADDR $2EBA; COMMENT "Fleche haut : ecrit 'N' puis valide"; };
LABEL { NAME "key_dir_put"; ADDR $2EBC; COMMENT "Ecrit la lettre de direction dans le tampon, echo, puis valide par CR"; };
LABEL { NAME "key_w"; ADDR $2EC6; COMMENT "Fleche gauche : ecrit 'W' puis valide"; };
LABEL { NAME "key_e"; ADDR $2ECB; COMMENT "Fleche droite : ecrit 'E' puis valide"; };
LABEL { NAME "key_s"; ADDR $2ED0; COMMENT "Fleche bas : ecrit 'S' puis valide"; };
LABEL { NAME "tokenize"; ADDR $2ED5; COMMENT "Lit le mot suivant du tampon, le cherche au dictionnaire et renvoie son type et son adresse"; };
LABEL { NAME "lex_cr"; ADDR $2F26; COMMENT "Fin de ligne : produit le token de type $C0 (fin de commande)"; };
LABEL { NAME "lex_emit"; ADDR $2F28; COMMENT "Prepare le token courant (adresse vide) puis passe a l'emission du type"; };
LABEL { NAME "lex_type"; ADDR $2F30; COMMENT "Renseigne le type du token ($5B), combine l'adresse et rend la main"; };
LABEL { NAME "lex_restore"; ADDR $2F3B; COMMENT "Restaure le pointeur d'entree sauvegarde apres le test d'abreviation"; };
LABEL { NAME "word_finish"; ADDR $2F43; COMMENT "Mot trouve : suit un eventuel renvoi, extrait son type et son adresse de dictionnaire"; };
LABEL { NAME "word_skip"; ADDR $2F47; COMMENT "Avance jusqu'au dernier octet de lettres du mot (bit7 pose)"; };
LABEL { NAME "word_grammar"; ADDR $2F60; COMMENT "Teste le bit de renvoi de l'entree et suit la redirection de pointeur si pose"; };
LABEL { NAME "word_type"; ADDR $2F78; COMMENT "Extrait le nibble de type (bits 6-5 des 2 premiers octets) et le range dans $5B"; };
LABEL { NAME "punct_class"; ADDR $2FA3; COMMENT "Classe un signe de ponctuation : point ($B0), virgule ($A0) ou guillemet ($90)"; };
LABEL { NAME "punct_hit"; ADDR $2FB8; COMMENT "Signe de ponctuation reconnu : avance le curseur et renvoie son type"; };
LABEL { NAME "dict_bucket"; ADDR $2FBB; COMMENT "Decode les lettres du mot cherche et se place sur le seau de dictionnaire de sa 1re lettre"; };
LABEL { NAME "dict_start"; ADDR $2FCE; COMMENT "Calcule le seau $0500[2*lettre] et positionne le pointeur sur sa 1re entree"; };
LABEL { NAME "dict_next"; ADDR $2FEA; COMMENT "Avance de la taille de l'entree courante et compare la 1re lettre de la suivante"; };
LABEL { NAME "dict_cmp1"; ADDR $2FF4; COMMENT "Compare la 1re lettre de l'entree au mot cherche"; };
LABEL { NAME "dict_read"; ADDR $3000; COMMENT "Entree correspondante : decode ses lettres dans $47D3 et mesure sa longueur"; };
LABEL { NAME "dict_letters"; ADDR $3008; COMMENT "Decode les lettres 5 bits d'une entree de dictionnaire (bit7 = suite)"; };
LABEL { NAME "dict_letter_next"; ADDR $3012; COMMENT "Gere les cas particuliers de 2 et 3 lettres (fin de mot)"; };
LABEL { NAME "dict_end"; ADDR $302B; COMMENT "Fin des lettres : note la longueur du candidat ($67) et le bit de renvoi"; };
LABEL { NAME "dict_done"; ADDR $3037; COMMENT "Fin de lecture d'une entree : rend Z (A=0) quand la 1re lettre correspond"; };
LABEL { NAME "word_prefix_cmp"; ADDR $303C; COMMENT "Compare le mot saisi et le candidat sur la longueur commune (prefixe)"; };
LABEL { NAME "cmp_min"; ADDR $3048; COMMENT "Longueur de comparaison = minimum des deux longueurs"; };
LABEL { NAME "cmp_loop"; ADDR $304B; COMMENT "Boucle de comparaison lettre a lettre"; };
LABEL { NAME "cmp_diff"; ADDR $305E; COMMENT "Difference trouvee : rend Z clair (A=1)"; };
LABEL { NAME "cmd_store"; ADDR $3065; COMMENT "Recopie les mots de la commande du tampon de travail $4927 vers $4A17"; };
LABEL { NAME "boot_copyback"; ADDR $30BB; COMMENT "Copie la memoire de travail vers la zone de sauvegarde (sens inverse de boot_copy)"; };
LABEL { NAME "boot_ptr_step"; ADDR $30DF; COMMENT "Avance les pointeurs de copie (ptr, $8C) et recule ptr2 d'un cran ; rend Z en fin de segment"; };
LABEL { NAME "next_word"; ADDR $311C; COMMENT "Debut d'un nouveau mot a analyser (remet le compteur de virgules $9D)"; };
LABEL { NAME "next_phrase"; ADDR $3135; COMMENT "Reinitialise l'accumulateur de groupe nominal et lit le token suivant"; };
LABEL { NAME "dispatch"; ADDR $3144; COMMENT "Lit le token courant et saute vers le handler de sa classe (table $315A)"; };
LABEL { NAME "cls_direction"; ADDR $328F; COMMENT "Classe 2 (direction) : enregistre la direction demandee"; };
LABEL { NAME "cls_adverb"; ADDR $3299; COMMENT "Classe 0 (adverbe) : annonce le mode de l'action (doucement, vite...)"; };
LABEL { NAME "cls_conj"; ADDR $32B9; COMMENT "Classe 10 (AND / virgule) : enchainement de plusieurs objets"; };
LABEL { NAME "cls_go"; ADDR $32E9; COMMENT "Classe 4 (GO/RUN) : verbes de deplacement"; };
LABEL { NAME "cls_verb"; ADDR $32F3; COMMENT "Classe 3 (verbe) : fixe le verbe de la commande et attend ses objets"; };
LABEL { NAME "cls_article"; ADDR $3374; COMMENT "Classe 8 (article/determinant : THE, A...) : annonce un nom et lit la suite"; };
LABEL { NAME "cls_prep_in"; ADDR $337D; COMMENT "Classe 1 (IN/INTO) : preposition de lieu"; };
LABEL { NAME "cls_preposition"; ADDR $3390; COMMENT "Classe 7 (preposition : ON, THROUGH, WITH...) : separe sujet et complement"; };
LABEL { NAME "cls_adjective"; ADDR $33BF; COMMENT "Classe 6 (adjectif) : ajoute un qualificatif au groupe nominal courant"; };
LABEL { NAME "cls_noun"; ADDR $33C8; COMMENT "Classe 5 (nom) : enregistre l'objet ou le lieu designe"; };
LABEL { NAME "noun_slot_set6"; ADDR $340B; COMMENT "Cherche un emplacement libre du groupe nominal a partir de l'offset 6 et y range l'adresse du mot"; };
LABEL { NAME "noun_prep_count"; ADDR $3429; COMMENT "Compteur de prepositions ($9D) : +1, echoue au-dela de 2, sinon cherche un emplacement"; };
LABEL { NAME "noun_slot_put"; ADDR $343A; COMMENT "Range le groupe nominal courant dans l'enregistrement de commande (offset selon $6D) ou echoue"; };
