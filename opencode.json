{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "rtk git add*": "allow",
      "rtk git commit*": "ask",
      "rtk git push*": "ask",
      "/tmp/*": "allow"
    },
  },
  "lsp": {
    "gopls": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ]
    },
    "eslint": {
      "command": [
        "vscode-eslint-language-server",
        "--stdio"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs"
      ]
    }
  }
}